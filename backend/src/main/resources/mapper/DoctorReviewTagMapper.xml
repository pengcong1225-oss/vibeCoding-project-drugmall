<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.drugmall.mapper.DoctorReviewTagMapper">

    <select id="selectByDoctorId" resultType="com.drugmall.entity.DoctorReviewTag">
        SELECT * FROM dm_doctor_review_tag
        WHERE doctor_id = #{doctorId}
        AND status = 1
        AND is_deleted = 0
        ORDER BY tag_count DESC
    </select>

</mapper>
