<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.drugmall.mapper.StoreCertificationMapper">

    <select id="selectByStoreId" resultType="com.drugmall.entity.StoreCertification">
        SELECT * FROM dm_store_certification
        WHERE store_id = #{storeId} AND status = 1
    </select>

</mapper>
